#include <iostream>

using namespace std;

int main() {
    int n = 5;
    int m = 5;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++) {
            if (i == 0 || i == 2 || i == 4 || (i == 1 && j == 0) || (i == 3 && j == 4)) {
                cout << "* ";
            } else {
                cout << "  ";
            }
        }

        cout << "   ";

        for (int j = 0; j < m; j++)
        {
            if (j == 0 || ((i == 0 || i == 2) && j < 4) || (i == 1 && j == 4)) {
                cout << "* ";
            } else {
                cout << "  ";
            }
        }

        cout << "   ";

        for (int j = 0; j < m; j++)
        {
            if (i == 0 || i == 4 || j == 0 || (i == 2 && j >= 2) || (i == 3 && j == 4)) {
                cout << "* ";
            } else {
                cout << "  ";
            }
        }

        cout << endl;
    }

    return 0;
}
    